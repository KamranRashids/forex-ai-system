# ============================================================================
# Forex AI System — environment template
#
# Copy to .env before running:   cp .env.example .env
# NEVER commit a real .env. Values below are safe development defaults.
#
# SAFE MODE: TRADING_MODE accepts ONLY "safe". The backend refuses to start
# with any other value; live order execution does not exist in this codebase.
# ============================================================================

# --- Core ---------------------------------------------------------------------
APP_ENV=dev                          # dev | prod
TRADING_MODE=safe                    # only "safe" is accepted (SAFE MODE layer L1)
LOG_LEVEL=INFO
SECRET_KEY=change-me-generate-a-64-char-random-hex-string-before-phase-1
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:3000
SENTRY_DSN=                          # empty disables Sentry entirely

# --- Host-side ports -----------------------------------------------------------
API_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- PostgreSQL -----------------------------------------------------------------
POSTGRES_DB=forex_ai
POSTGRES_USER=forex
POSTGRES_PASSWORD=change-me-dev-only
# From host tools use localhost; containers reach the DB at host "postgres":
DATABASE_URL=postgresql+asyncpg://forex:change-me-dev-only@localhost:5432/forex_ai

# --- Redis ------------------------------------------------------------------------
# Containers reach Redis at redis://redis:6379/0 inside the compose network:
REDIS_URL=redis://localhost:6379/0

# --- Market data --------------------------------------------------------------------
# Provider-independent interface (ADR-0003): oanda | synthetic
# "synthetic" is deterministic and needs no credentials — default for dev/tests.
MARKET_DATA_PROVIDER=synthetic
MARKET_DATA_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD
# Engine supports M5,M15,H1,H4,D1; ADR-0003 default starts M15,H1,H4 —
# M5/D1 are enabled by configuration only.
MARKET_DATA_TIMEFRAMES=M15,H1,H4
OANDA_API_TOKEN=
OANDA_ENV=practice                   # only "practice" is permitted in v1
INGEST_INTERVAL_SECONDS=10

# --- News & economic calendar (Phase 4) -------------------------------------------------
# Provider-independent interface: synthetic | finnhub
# "synthetic" is deterministic seeded/demo data and needs no credentials —
# default for dev/tests. The app runs fully with zero external keys.
NEWS_PROVIDER=synthetic
CALENDAR_PROVIDER=synthetic
FINNHUB_API_TOKEN=                      # required only when either provider = finnhub
NEWS_POLL_SECONDS=300
CALENDAR_POLL_SECONDS=3600
NEWS_LOOKBACK_HOURS=24
CALENDAR_LOOKBACK_HOURS=48
NEWS_DEDUP_DAYS=7
CALENDAR_DEDUP_DAYS=7

# --- LLM (OpenCode Zen / Ox Alpha Free initially — ADR-0004) -----------------------------
# opencode_zen | none   ("none" => deterministic fallbacks only; default powers
# the zero-key exit criterion)
LLM_PROVIDER=none
OPENCODE_ZEN_BASE_URL=https://opencode.ai/api
OPENCODE_ZEN_API_KEY=                   # empty => fallbacks only
OPENCODE_ZEN_MODEL=ox-alpha-free
LLM_MAX_TOKENS=512
LLM_DAILY_BUDGET_USD=0.00               # 0 => no budget spent; fallbacks used
LLM_TIMEOUT_SECONDS=30.0

# --- Frontend ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

TZ=UTC
