  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "panels": [],
      "title": "Worker Heartbeats / Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "1 = worker heartbeat fresh (up), 0 = stale/down",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "bool"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "worker_up",
          "legendFormat": "{{role}}",
          "refId": "A"
        }
      ],
      "title": "Worker Up (ingest / agents / content / orchestrator)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Seconds since each worker's last heartbeat; crossing the TTL marks it stale/down",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "worker_heartbeat_age_seconds",
          "legendFormat": "{{role}}",
          "refId": "A"
        }
      ],
      "title": "Worker Heartbeat Age (s)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 11,
      "panels": [],
      "title": "Market Data & Content Staleness",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Number of stale (symbol, timeframe) series at the last ingest staleness check",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "staleness_breach_count", "legendFormat": "breaches", "refId": "A" }
      ],
      "title": "Staleness Breach Count",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Oldest staleness gap (seconds) at the last check; shows how far behind a series has fallen",
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "staleness_max_age_seconds", "legendFormat": "max gap", "refId": "A" }
      ],
      "title": "Max Staleness Gap (s)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 12,
      "panels": [],
      "title": "Processing / Event Rates",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Rate of HTTP requests served by the API",
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "id": 5,
      "options": { "legend": { "displayMode": "hidden" } },
      "targets": [
        { "expr": "sum(rate(http_requests_total[1m]))", "legendFormat": "requests/s", "refId": "A" }
      ],
      "title": "HTTP requests / s",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Rate of agent signals published",
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "id": 6,
      "options": { "legend": { "displayMode": "hidden" } },
      "targets": [
        { "expr": "sum(rate(agent_signals_total[5m]))", "legendFormat": "signals/s", "refId": "A" }
      ],
      "title": "Agent signals / s",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Rate of orchestrator decisions persisted",
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "id": 7,
      "options": { "legend": { "displayMode": "hidden" } },
      "targets": [
        { "expr": "sum(rate(orch_decisions_total[5m]))", "legendFormat": "decisions/s", "refId": "A" }
      ],
      "title": "Orchestrator decisions / s",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 13,
      "panels": [],
      "title": "Orchestrator Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Orchestrator scan cycles executed; flat line with no new cycles signals a stall",
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 8,
      "options": { "legend": { "displayMode": "hidden" } },
      "targets": [
        { "expr": "sum(rate(orch_cycles_total[5m]))", "legendFormat": "cycles/s", "refId": "A" }
      ],
      "title": "Orchestrator scan cycles / s",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "End-to-end time to build and persist one decision; spike indicates a slow cycle",
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 9,
      "options": { "legend": { "displayMode": "hidden" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(orch_decision_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "A" }
      ],
      "title": "Decision latency p95 (s)",
      "type": "timeseries"
    }
  ],
